root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# Archived comparison material must remain byte-for-byte identical to its source.
[reference/prototype-original/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
