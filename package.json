{
  "name": "cascade-design-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify": "npm run build && node scripts/verify-build.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:responsive": "playwright test tests/e2e/responsive-foundation.spec.js tests/e2e/responsive-layout.spec.js tests/e2e/responsive-boundaries.spec.js",
    "test:e2e:report": "playwright show-report",
    "test:e2e:concept": "playwright test tests/e2e/concept.spec.js --project=desktop-chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^7.1.5",
    "vite-plugin-handlebars": "^2.0.0"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0"
  }
}
